// Stock Management System (SMS) - Prisma Database Schema
// Tasks: BE-010, BE-021 (Users Schema), BE-022 (Roles Schema), BE-023 (Permissions Schema)
// SRS Traceability: Section 10.1 (Core Entities), Appendix C (Permissions Matrix)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System Health / Setting Model
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// User Status Enum
enum UserStatus {
  ACTIVE
  INACTIVE
}

// User Identity Model
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

// Role Model (BE-022)
model Role {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  securityLevel Int      @default(10) @map("security_level")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// Permission Model (BE-023)
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}
