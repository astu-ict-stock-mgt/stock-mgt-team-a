// ────────────────────────────────────────────────────
// RELATIONSHIPS
// ────────────────────────────────────────────────────

// --- Category hierarchy ---
Ref: categories.parent_id > categories.id

// --- Item relationships ---
Ref: items.category_id > categories.id
Ref: items.unit_id > units.id
Ref: items.supplier_id > suppliers.id

// --- User-Role join ---
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.assigned_by > users.id

// --- Role-Permission join ---
Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id

// --- Store relationships ---
Ref: stores.responsible_officer_id > users.id

// --- Department relationships ---
Ref: departments.head_user_id > users.id

// --- Store-Department join ---
Ref: store_departments.store_id > stores.id
Ref: store_departments.department_id > departments.id

// --- Location hierarchy ---
Ref: locations.store_id > stores.id
Ref: locations.parent_id > locations.id

// --- Goods Receipt ---
Ref: goods_receipts.supplier_id > suppliers.id
Ref: goods_receipts.store_id > stores.id
Ref: goods_receipts.department_id > departments.id
Ref: goods_receipts.received_by > users.id

// --- Goods Receipt Lines ---
Ref: goods_receipt_lines.goods_receipt_id > goods_receipts.id
Ref: goods_receipt_lines.item_id > items.id
Ref: goods_receipt_lines.unit_id > units.id
Ref: goods_receipt_lines.location_id > locations.id

// --- Technical Evaluation ---
Ref: technical_evaluations.goods_receipt_id > goods_receipts.id
Ref: technical_evaluations.evaluator_id > users.id

// --- GRN ---
Ref: grns.goods_receipt_id > goods_receipts.id
Ref: grns.approved_by > users.id
Ref: grns.finalized_by > users.id

// --- Stock Cards ---
Ref: stock_cards.item_id > items.id
Ref: stock_cards.store_id > stores.id

// --- Stock Card Transactions ---
Ref: stock_card_transactions.stock_card_id > stock_cards.id
Ref: stock_card_transactions.created_by > users.id

// --- Stock Batches ---
Ref: stock_batches.stock_card_id > stock_cards.id

// --- Bin Cards ---
Ref: bin_cards.item_id > items.id
Ref: bin_cards.location_id > locations.id

// --- Bin Transactions ---
Ref: bin_transactions.bin_card_id > bin_cards.id
Ref: bin_transactions.created_by > users.id

// --- Requisition ---
Ref: requisitions.requester_id > users.id
Ref: requisitions.department_id > departments.id
Ref: requisitions.store_id > stores.id
Ref: requisitions.department_approved_by > users.id
Ref: requisitions.pao_approved_by > users.id

// --- Requisition Lines ---
Ref: requisition_lines.requisition_id > requisitions.id
Ref: requisition_lines.item_id > items.id

// --- SIV ---
Ref: sivs.requisition_id > requisitions.id
Ref: sivs.store_id > stores.id
Ref: sivs.issued_to_user_id > users.id
Ref: sivs.prepared_by > users.id
Ref: sivs.approved_by > users.id

// --- SIV Lines ---
Ref: siv_lines.siv_id > sivs.id
Ref: siv_lines.item_id > items.id

// --- Returns ---
Ref: returns.siv_id > sivs.id
Ref: returns.requested_by > users.id
Ref: returns.store_id > stores.id
Ref: returns.evaluated_by > users.id
Ref: returns.approved_by > users.id

// --- Return Lines ---
Ref: return_lines.return_id > returns.id
Ref: return_lines.item_id > items.id

// --- Transfer Requests ---
Ref: transfer_requests.source_store_id > stores.id
Ref: transfer_requests.destination_store_id > stores.id
Ref: transfer_requests.source_location_id > locations.id
Ref: transfer_requests.destination_location_id > locations.id
Ref: transfer_requests.requested_by > users.id
Ref: transfer_requests.approved_by > users.id

// --- Transfer Lines ---
Ref: transfer_lines.transfer_id > transfer_requests.id
Ref: transfer_lines.item_id > items.id

// --- Fixed Assets ---
Ref: fixed_assets.item_id > items.id
Ref: fixed_assets.grn_id > grns.id
Ref: fixed_assets.custodian_id > users.id
Ref: fixed_assets.department_id > departments.id
Ref: fixed_assets.location_id > locations.id

// --- Shelf Life ---
Ref: shelflife_records.item_id > items.id
Ref: shelflife_records.store_id > stores.id
Ref: shelflife_records.location_id > locations.id

// --- Disposal Requests ---
Ref: disposal_requests.store_id > stores.id
Ref: disposal_requests.requested_by > users.id
Ref: disposal_requests.evaluated_by > users.id
Ref: disposal_requests.approved_by > users.id
Ref: disposal_requests.executed_by > users.id

// --- Disposal Lines ---
Ref: disposal_request_lines.disposal_request_id > disposal_requests.id
Ref: disposal_request_lines.item_id > items.id
Ref: disposal_request_lines.location_id > locations.id

// --- Reconciliation ---
Ref: reconciliations.store_id > stores.id
Ref: reconciliations.initiated_by > users.id
Ref: reconciliations.approved_by > users.id
Ref: reconciliations.posted_by > users.id

// --- Reconciliation Lines ---
Ref: reconciliation_lines.reconciliation_id > reconciliations.id
Ref: reconciliation_lines.item_id > items.id
Ref: reconciliation_lines.location_id > locations.id

// --- Stock Takes ---
Ref: stock_takes.store_id > stores.id
Ref: stock_takes.initiated_by > users.id
Ref: stock_takes.completed_by > users.id
Ref: stock_takes.reconciled_by > users.id

// --- Stock Take Lines ---
Ref: stock_take_lines.stock_take_id > stock_takes.id
Ref: stock_take_lines.item_id > items.id
Ref: stock_take_lines.location_id > locations.id

// --- Notifications ---
Ref: notifications.user_id > users.id

// --- Audit Events ---
Ref: audit_events.user_id > users.id
